{
  "name": "agent-watch",
  "version": "0.1.0",
  "description": "Observability SDK for AI agents in production \u2014 traces, spans, and a local dashboard. Zero cloud, self-hosted.",
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "bin": {
    "agent-watch": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/dashboard/public dist/dashboard/public",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build",
    "postbuild": "cp -r src/dashboard/public dist/dashboard/public 2>/dev/null || true"
  },
  "keywords": [
    "ai",
    "observability",
    "tracing",
    "llm",
    "openai",
    "anthropic",
    "langchain",
    "sqlite"
  ],
  "author": "Raul Rosello <raul@rankgnar.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rankgnar/agent-watch.git"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "express": "^4.18.3",
    "@anthropic-ai/sdk": "^0.78.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.2"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
